# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3.5-super-vl:free,recursive/flint-v1.0:free
OPENROUTER_TIMEOUT_SECONDS=30

# Database Configuration (PostgreSQL with pgvector, falls back to SQLite if unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/vectordb
SQLITE_DB_PATH=data/vectordb.sqlite

# Embedding Model Configuration
EMBEDDING_MODEL=BAAI/bge-m3

# API Server URL
API_URL=http://localhost:8000
